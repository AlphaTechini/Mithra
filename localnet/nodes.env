# LocalNet topology for Mithra: three nodes, one DecMan instance per node.
# Plain KEY=VALUE (no export, no expansion) so bash (source) and docker compose (--env-file) agree.
# Every endpoint the scripts and the backend use comes from here; nothing is hard-coded elsewhere.

# Host name the scripts use to reach published ports.
LOCALNET_HOST=localhost
# Docker network created by the Splice LocalNet compose project; DecMan joins it.
DOCKER_NETWORK=localnet

# LocalNet auth (documented unsafe defaults: HS256 secret "unsafe"; the user is admin on every node).
LEDGER_USER_ID=ledger-api-user
LEDGER_HMAC_SECRET=unsafe
LEDGER_AUDIENCE=https://canton.network.global

# The treasury Decentralized Party (party id hint) and its hosting threshold.
TREASURY_PARTY_HINT=mithra-treasury
HOSTING_THRESHOLD=2
# Confirmations needed by GovernanceRules to execute a governed action.
GOVERNANCE_THRESHOLD=2

# Validator (scan proxy) on the app-provider node: Token Standard registry and DSO party id.
REGISTRY_PORT=3000
# Scan UI/API on the sv node, used only as a fallback to read the DSO party id.
SCAN_PORT=4000

NODE_IDS="a b c"

# Node A: Mithra's own node (LocalNet app-provider). Hosts the agent, operator and every demo party.
NODE_A_NAME="Node A"
NODE_A_OPERATOR="Mithra Labs (app provider)"
NODE_A_PARTICIPANT=app-provider
NODE_A_LEDGER_PORT=3901
NODE_A_ADMIN_PORT=3902
NODE_A_JSON_PORT=3975
NODE_A_DECMAN_PORT=8081
NODE_A_DECMAN_NOISE_PORT=9001
NODE_A_DECMAN_CONTAINER=dm-a
NODE_A_AUTO_CONFIRM=true

# Node B: the fund administrator's node (LocalNet app-user).
NODE_B_NAME="Node B"
NODE_B_OPERATOR="Ledgerline Fund Services (fund administrator)"
NODE_B_PARTICIPANT=app-user
NODE_B_LEDGER_PORT=2901
NODE_B_ADMIN_PORT=2902
NODE_B_JSON_PORT=2975
NODE_B_DECMAN_PORT=8082
NODE_B_DECMAN_NOISE_PORT=9002
NODE_B_DECMAN_CONTAINER=dm-b
NODE_B_AUTO_CONFIRM=true

# Node C: the synchronizer operator's node (LocalNet sv). Its operator confirms by hand in DecMan.
NODE_C_NAME="Node C"
NODE_C_OPERATOR="Canton super validator (synchronizer operator)"
NODE_C_PARTICIPANT=sv
NODE_C_LEDGER_PORT=4901
NODE_C_ADMIN_PORT=4902
NODE_C_JSON_PORT=4975
NODE_C_DECMAN_PORT=8083
NODE_C_DECMAN_NOISE_PORT=9003
NODE_C_DECMAN_CONTAINER=dm-c
NODE_C_AUTO_CONFIRM=false
