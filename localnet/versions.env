# Pinned versions for the Mithra LocalNet. Plain KEY=VALUE so that both bash (source) and
# docker compose (--env-file) can read it.

# Splice release whose docker-compose/localnet bundle defines the LocalNet (Canton 3.5.x, three
# participants in one container). DecMan's own three-node e2e boots LocalNet from this version.
SPLICE_VERSION=0.6.12
SPLICE_BUNDLE_URL=https://github.com/digital-asset/decentralized-canton-sync/releases/download/v0.6.12/0.6.12_splice-node.tar.gz
# SHA-256 of 0.6.12_splice-node.tar.gz (checked after every download).
SPLICE_BUNDLE_SHA256=e15e8263156f4f220ce44046332830abf3f83f6f40c68a8152eaae5504ebcd73

# BitSafe Decentralization Manager (one instance per node).
DECMAN_IMAGE=public.ecr.aws/dlc-link/decentralization-manager:v1.13.0
