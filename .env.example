# Mithra environment. Copy to .env and fill in. Never commit .env.

# ---- Common ----

# Network to run against: localnet or mainnet. Selects endpoints and wallet behavior.
NETWORK=localnet

# Interface the backend binds to.
HOST=0.0.0.0

# Port the backend listens on.
PORT=8787

# Origin of the web dev server, allowed by CORS in development.
WEB_ORIGIN=http://localhost:5173

# Path to the built web app (apps/web/build) that the backend serves in production; leave empty in dev.
WEB_DIST_DIR=

# Log level for the backend: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# PostgreSQL connection string for the application database.
DATABASE_URL=postgres://mithra:mithra@localhost:5432/mithra

# Secret that signs the session cookie, at least 32 characters (for example: openssl rand -hex 32).
SESSION_SECRET=

# Base URL of the OpenAI-compatible LLM endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# API key for the OpenAI-compatible LLM endpoint.
LLM_API_KEY=

# Model name sent to the LLM endpoint.
LLM_MODEL=

# Timeout in milliseconds for one LLM request.
LLM_TIMEOUT_MS=30000

# ---- Ledger and asset (both networks) ----

# Daml package reference of the Mithra model used in ledger requests, for example #mithra-v1.
MITHRA_PACKAGE=#mithra-v1

# JSON Ledger API v2 base URL of the participant node that hosts the agent and operator parties.
LEDGER_JSON_API_URL=http://localhost:3975

# Ledger user the backend acts as; it needs act-as rights for the agent and operator.
LEDGER_USER_ID=ledger-api-user

# How the backend authenticates to the ledger: unsafe-hmac, oidc-client-credentials or none (default unsafe-hmac on localnet, required on mainnet).
LEDGER_AUTH_MODE=unsafe-hmac

# HMAC secret that signs ledger tokens in unsafe-hmac mode (LocalNet default: unsafe).
LEDGER_HMAC_SECRET=unsafe

# Audience claim of ledger tokens in unsafe-hmac mode.
LEDGER_AUDIENCE=https://canton.network.global

# OIDC token endpoint for the ledger in oidc-client-credentials mode.
LEDGER_OIDC_TOKEN_URL=

# OIDC client id for the ledger in oidc-client-credentials mode.
LEDGER_OIDC_CLIENT_ID=

# OIDC client secret for the ledger in oidc-client-credentials mode.
LEDGER_OIDC_CLIENT_SECRET=

# OIDC audience for the ledger token in oidc-client-credentials mode.
LEDGER_OIDC_AUDIENCE=

# OIDC scope for the ledger token in oidc-client-credentials mode.
LEDGER_OIDC_SCOPE=

# Party id of the treasury (on LocalNet the Decentralized Party, on MainNet the treasurer).
TREASURY_PARTY=

# Party id of the Mithra agent, hosted on the node at LEDGER_JSON_API_URL.
AGENT_PARTY=

# Party id of the Mithra operator, hosted on the node at LEDGER_JSON_API_URL.
OPERATOR_PARTY=

# Party id of the distributed instrument admin (the DSO party for CC).
ASSET_ADMIN_PARTY=

# Instrument id of the distributed asset (Amulet for CC).
ASSET_ID=Amulet

# Symbol shown to people for the distributed asset.
ASSET_SYMBOL=CC

# Base URL of the token standard registry API for the distributed asset.
REGISTRY_URL=http://localhost:3000/api/validator/v0/scan-proxy

# ---- LocalNet only (scripts/localnet-up.sh writes most of these to localnet/.state/localnet.env) ----

# LocalNet only: the password people type to enter the demo.
LOCALNET_DEMO_PASSWORD=

# LocalNet only: JSON list of demo parties for the role switcher, [{"partyId":"...","displayName":"Treasurer"}].
LOCALNET_DEMO_PARTIES=

# LocalNet only: true if the ledger user may read as the treasury party (default true).
LOCALNET_READ_AS_TREASURY=true

# LocalNet only: JSON list of exactly three nodes [{"id","name","operator","jsonApiUrl","decmanUrl","autoConfirm"}].
LOCALNET_NODES=

# LocalNet only: number of node confirmations the Decentralization Manager needs for a governed action (default 2).
DECMAN_GOVERNANCE_THRESHOLD=2

# ---- MainNet only ----

# MainNet only: block explorer link for a transaction, containing {updateId}.
MAINNET_EXPLORER_TX_URL=

# MainNet only: minimum Grofty Wallet version the signing flow needs (default 2.0.4).
GROFTY_MIN_VERSION=2.0.4

# Dev only: backend URL the web dev server proxies /api to (read by apps/web/vite.config.ts).
MITHRA_API_PROXY=http://localhost:8787
