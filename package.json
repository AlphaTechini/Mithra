{
  "name": "mithra",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "daml:build": "scripts/daml.sh build",
    "daml:test": "scripts/daml.sh test",
    "seed:localnet": "pnpm --filter @mithra/backend seed",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:lighthouse": "E2E_LIGHTHOUSE=1 playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
