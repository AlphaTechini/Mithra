-- | L1 (cap), L3 (one distribution per cycle), L6 (only the treasurer changes terms),
-- A5 (checks and flags).
module Mithra.Test.Mandate where

import Daml.Script
import DA.Date
import DA.Foldable (forA_)
import Mithra.Decision
import Mithra.Mandate
import Mithra.Org
import Mithra.Payment
import Mithra.Proposal
import Mithra.Types
import Mithra.Units
import Mithra.Test.Setup

-- L1 -------------------------------------------------------------------------

-- | A total equal to the cap executes in one step.
test_l1_total_equals_cap_executes : Script ()
test_l1_total_equals_cap_executes = do
  fx <- setup
  (proposalCid, recordCid) <- proposeTotal fx "2026-09" 5000.0
  p <- proposalOf fx proposalCid
  assertMsg "total = cap is auto-execute" (p.verdict == AutoExecute)
  d <- decisionOf fx recordCid
  assertMsg "the decision record says the same" (d.verdict == AutoExecute && d.cap == 5000.0)
  before <- treasuryBalance fx
  (mandateCid, outcomeCid) <- execute fx proposalCid
  after <- treasuryBalance fx
  assertMsg "the treasury paid exactly the total" (before - after == 5000.0)
  a <- holderBalance fx.holderA
  b <- holderBalance fx.holderB
  c <- holderBalance fx.holderC
  assertMsg "holders received 500 / 1,500 / 3,000" ((a, b, c) == (500.0, 1500.0, 3000.0))
  o <- outcomeOf fx outcomeCid
  assertMsg "outcome is Executed" (o.kind == Executed)
  m <- mandateOf fx mandateCid
  assertMsg "the cycle is recorded on the Mandate" (m.executedCycles == ["2026-09"])

-- | One unit of Decimal above the cap needs approval, and the agent cannot execute it.
test_l1_cap_plus_epsilon_needs_approval : Script ()
test_l1_cap_plus_epsilon_needs_approval = do
  fx <- setup
  (proposalCid, recordCid) <- proposeTotal fx "2026-09" 5000.0000000001
  p <- proposalOf fx proposalCid
  assertMsg "cap + 1e-10 needs approval" (p.verdict == NeedsApproval)
  d <- decisionOf fx recordCid
  assertMsg "the decision record says so" (d.verdict == NeedsApproval)
  before <- treasuryBalance fx
  cmd <- executeCmd fx proposalCid
  failsWith "needs 2 approval(s)" (asAgent fx) cmd
  after <- treasuryBalance fx
  assertMsg "nothing was paid" (before == after)
  m <- liveMandate fx
  assertMsg "the cycle is still open" (m.executedCycles == [])

-- | Lowering the cap after a proposal blocks an auto-execute proposal above the new cap.
test_l1_cap_lowered_after_proposal_blocks_execution : Script ()
test_l1_cap_lowered_after_proposal_blocks_execution = do
  fx <- setup
  (proposalCid, _) <- proposeTotal fx "2026-09" 5000.0
  fx1 <- reseal fx (fx.terms with cap = 4000.0)
  cmd <- executeCmd fx1 proposalCid
  failsWith "above the auto-execute cap of 4,000 CC" (asAgent fx1) cmd
  -- the proposal cannot be rescued by approvals either: it was not an approval proposal
  failsWith "needs no approval" (actAs fx.approver1) (approveCmd proposalCid fx.approver1)
  balance <- treasuryBalance fx1
  assertMsg "nothing was paid" (balance == 1000000.0)
  -- the stale proposal can be cancelled and a new one proposed within the new cap
  _ <- submit fx.treasurer $ exerciseCmd proposalCid Proposal_Cancel
  (smaller, _) <- proposeTotal fx1 "2026-09" 4000.0
  _ <- execute fx1 smaller
  pure ()

-- | The error message shown to people spells out the numbers.
test_l1_message_shows_amounts : Script ()
test_l1_message_shows_amounts = do
  fx <- setup
  (proposalCid, _) <- proposeTotal fx "2026-09" 5000.0
  fx1 <- reseal fx (fx.terms with cap = 1234.5)
  cmd <- executeCmd fx1 proposalCid
  failsWith "Total 5,000 CC is above the auto-execute cap of 1,234.5 CC" (asAgent fx1) cmd

-- L3 -------------------------------------------------------------------------

-- | At most one executed distribution per cycle, on both the propose and the execute path.
test_l3_second_execution_same_cycle_fails : Script ()
test_l3_second_execution_same_cycle_fails = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  (first, _) <- propose fx input
  (second, _) <- propose fx (input with attempt = 2)
  (mandateCid, _) <- execute fx first
  let fx1 = afterExecute fx mandateCid
  -- execute path: the second proposal was made before the first executed
  cmd <- executeCmd fx1 second
  failsWith "has already been executed" (asAgent fx1) cmd
  -- propose path
  proposeFailsWith "has already been executed" fx1 (input with attempt = 3)
  -- a different cycle is unaffected
  _ <- distribute fx1 "2026-08" 1000.0
  balance <- treasuryBalance fx1
  assertMsg "both cycles paid 1,000" (balance == 998000.0)

-- L1, L3, L4: no way around the Mandate ----------------------------------------

-- | `Proposal_MarkExecuted` pays nothing and checks nothing: the cap, the approvals and the
-- one-payout-per-cycle rule are the Mandate's. So the treasury alone, or the treasurer alone,
-- cannot exercise it, whatever the proposal's state; only a Mandate choice, which carries both
-- signatures, can.
test_l1_mark_executed_not_reachable_without_the_mandate : Script ()
test_l1_mark_executed_not_reachable_without_the_mandate = do
  fx <- setup
  -- over the cap and without a single approval: the Mandate would refuse to execute it
  (proposalCid, _) <- proposeTotal fx "2026-09" 6000.0
  p <- proposalOf fx proposalCid
  assertMsg "the proposal needs approval" (p.verdict == NeedsApproval && null p.approvals)
  let markExecuted = exerciseCmd proposalCid Proposal_MarkExecuted with
        settlements =
          [ Settlement with
              holder = payout.holder; status = Paid; transferInstructionCid = None; externalReceiver = None
          | payout <- p.payouts ]
        actor = fx.treasury
  failsWith notAuthorized (actAs fx.treasury) markExecuted
  failsWith notAuthorized (actAs fx.treasurer) markExecuted
  failsWith notAuthorized (actAs fx.agent <> readAs fx.treasury) markExecuted
  -- nothing was recorded, and the Mandate still refuses the unapproved proposal
  payments <- query @Payment fx.treasury
  outcomes <- query @DistributionOutcome fx.treasury
  assertMsg "no payment and no outcome" (null payments && null outcomes)
  cmd <- executeCmd fx proposalCid
  failsWith "needs 2 approval(s)" (asAgent fx) cmd
  -- the execution paths still work: the Mandate holds the treasury's and the treasurer's authority
  approved <- approveBoth fx proposalCid
  (_, outcomeCid) <- execute fx approved
  o <- outcomeOf fx outcomeCid
  assertMsg "executed through the Mandate" (o.kind == Executed)

-- The cycle id and the record date are checked by the ledger, not trusted from the agent.

-- | The cycle id must be the canonical `YYYY-MM`.
test_cycle_id_must_be_canonical : Script ()
test_cycle_id_must_be_canonical = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  forA_ ["2026-09-b", "2026-9", "2026-13", "2026-00", "26-09", "Sep-2026", "2026-09-30", "2026/09", " 2026-09", "2026-09 ", "", "0000-09", "+026-09", "2026-0a", "２０２６-09"] $ \bad ->
    proposeFailsWith "The cycle id must be YYYY-MM" fx (input with cycleId = bad)
  -- nothing was proposed
  proposals <- query @Proposal fx.treasury
  assertMsg "no proposal" (null proposals)
  -- a second payout for the same period under another id is the case this closes
  _ <- propose fx input
  proposeFailsWith "The cycle id must be YYYY-MM" fx (input with cycleId = "2026-09-b"; attempt = 1)

-- | The pure helpers behind the cycle id and record date rules.
test_cycle_id_helpers : Script ()
test_cycle_id_helpers = do
  assertMsg "ids" (all isCycleId ["2026-09", "2026-12", "2026-01", "0001-01", "9999-12"])
  assertMsg "not ids" (not (any isCycleId ["2026-9", "2026-13", "2026-00", "2026-09-b", "", "2026", "26-09", "2026-09-30", "2026-9a"]))
  assertMsg "id of a date" (cycleIdOfDate (date 2026 Sep 30) == "2026-09" && cycleIdOfDate (date 2026 Jan 1) == "2026-01")
  assertMsg "id of a date with a short year" (cycleIdOfDate (date 987 Dec 31) == "0987-12")
  assertMsg "last day" (lastDayOfCycle "2026-09" == Some (date 2026 Sep 30))
  assertMsg "last day of a 31 day month" (lastDayOfCycle "2026-12" == Some (date 2026 Dec 31))
  assertMsg "last day of February" (lastDayOfCycle "2026-02" == Some (date 2026 Feb 28))
  assertMsg "last day of a leap February" (lastDayOfCycle "2024-02" == Some (date 2024 Feb 29))
  assertMsg "no last day for a bad id" (lastDayOfCycle "2026-9" == None && lastDayOfCycle "2026-09-b" == None)
  let lastDay = "last_day_of_previous_month"
      dayBefore = "day_before_payment"
  assertMsg "last day rule: the last day of the month" (recordDateProblem lastDay "2026-09" (date 2026 Sep 30) == None)
  assertMsg "last day rule: not another day of the month" (recordDateProblem lastDay "2026-09" (date 2026 Sep 29) /= None)
  assertMsg "last day rule: not the month after" (recordDateProblem lastDay "2026-09" (date 2026 Oct 31) /= None)
  assertMsg "last day rule: not the month before" (recordDateProblem lastDay "2026-09" (date 2026 Aug 31) /= None)
  assertMsg "last day rule: leap day" (recordDateProblem lastDay "2024-02" (date 2024 Feb 29) == None)
  assertMsg "day before payment: any day inside the month"
    (all (\d -> recordDateProblem dayBefore "2026-09" d == None) [date 2026 Sep 1, date 2026 Sep 15, date 2026 Sep 30])
  assertMsg "day before payment: not outside the month"
    (all (\d -> recordDateProblem dayBefore "2026-09" d /= None) [date 2026 Aug 31, date 2026 Oct 1, date 2025 Sep 15])
  assertMsg "unknown rule" (recordDateProblem "whenever" "2026-09" (date 2026 Sep 30) /= None)
  assertMsg "bad id" (recordDateProblem lastDay "2026-9" (date 2026 Sep 30) /= None)

-- | `last_day_of_previous_month`: the record date is the last day of the cycle's own month.
test_record_date_follows_last_day_rule : Script ()
test_record_date_follows_last_day_rule = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  assertMsg "the helper gives the last day" (input.recordDate == date 2026 Sep 30)
  forA_ [date 2026 Sep 29, date 2026 Sep 1, date 2026 Aug 31, date 2026 Oct 1] $ \bad ->
    proposeFailsWith "the last day of 2026-09" fx (input with recordDate = bad)
  _ <- propose fx input
  pure ()

-- | `day_before_payment`: any date inside the cycle month.
test_record_date_follows_day_before_payment_rule : Script ()
test_record_date_follows_day_before_payment_rule = do
  fx0 <- setup
  fx <- reseal fx0 (fx0.terms with recordDateRule = "day_before_payment")
  input <- inputFor fx "2026-09" 1000.0
  forA_ [date 2026 Aug 31, date 2026 Oct 1] $ \bad ->
    proposeFailsWith "must fall inside 2026-09" fx (input with recordDate = bad)
  -- inside the month is accepted, whichever day it is
  changes <- registerChanges fx
  let midMonth = date 2026 Sep 14
  _ <- propose fx (input with recordDate = midMonth; payouts = computeProRata 1000.0 (unitsAt midMonth changes))
  pure ()

-- | A record date that has not happened yet cannot be snapshotted, whatever the rule says.
test_record_date_cannot_be_in_the_future : Script ()
test_record_date_cannot_be_in_the_future = do
  fx0 <- setup
  -- the last day rule: October 31 is after the ledger's date (October 1)
  futureLastDay <- inputFor fx0 "2026-10" 1000.0
  assertMsg "the rule's date is Oct 31" (futureLastDay.recordDate == date 2026 Oct 31)
  proposeFailsWith "has not happened yet" fx0 futureLastDay
  -- the day before payment rule: inside the month, but tomorrow
  fx <- reseal fx0 (fx0.terms with recordDateRule = "day_before_payment")
  today' <- inputFor fx "2026-10" 1000.0
  proposeFailsWith "has not happened yet" fx (today' with recordDate = date 2026 Oct 2)
  -- the ledger's own date is fine
  _ <- propose fx (today' with recordDate = date 2026 Oct 1)
  pure ()

-- | A Mandate whose rule is not one the ledger knows cannot be proposed against.
test_unknown_record_date_rule_is_refused : Script ()
test_unknown_record_date_rule_is_refused = do
  fx0 <- setup
  fx <- reseal fx0 (fx0.terms with recordDateRule = "whenever")
  input <- inputFor fx "2026-09" 1000.0
  proposeFailsWith "Unknown record date rule whenever" fx input

-- Attempts -------------------------------------------------------------------

-- | `(cycleId, attempt)` is unique: the same attempt cannot be proposed twice, and a retry
-- takes the next number, so two decision records never share a record id.
test_attempt_numbers_are_unique_per_cycle : Script ()
test_attempt_numbers_are_unique_per_cycle = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  assertMsg "the first attempt is 1" (input.attempt == 1)
  (first, firstRecord) <- propose fx input
  -- the same (cycleId, attempt) again, even with a different memo or total
  proposeFailsWith "is not the next one" fx input
  other <- inputFor fx "2026-09" 2000.0
  proposeFailsWith "is not the next one" fx (other with attempt = 1)
  -- skipping a number or going back is refused too
  proposeFailsWith "is not the next one" fx (other with attempt = 3)
  -- the first proposal is cancelled; the retry is attempt 2
  _ <- submit fx.treasurer $ exerciseCmd first Proposal_Cancel
  assertMsg "the next attempt is 2" (other.attempt == 2)
  (second, secondRecord) <- propose fx other
  d1 <- decisionOf fx firstRecord
  d2 <- decisionOf fx secondRecord
  p2 <- proposalOf fx second
  assertMsg "record ids keep their format and differ"
    (d1.recordId == "decision/2026-09/1" && d2.recordId == "decision/2026-09/2" && p2.proposalId == "proposal/2026-09/2")
  -- another cycle starts at 1 again, and the Mandate remembers each cycle's last attempt
  third <- inputFor fx "2026-08" 1000.0
  assertMsg "a new cycle starts at attempt 1" (third.attempt == 1)
  _ <- propose fx third
  m <- liveMandate fx
  assertMsg "the Mandate keeps the last attempt per cycle"
    (lastAttemptOf "2026-09" m.cycleAttempts == 2 && lastAttemptOf "2026-08" m.cycleAttempts == 1
      && lastAttemptOf "2026-07" m.cycleAttempts == 0)
  -- a rejected proposal is retried the same way
  _ <- submit fx.approver1 $ exerciseCmd second Proposal_Reject with approver = fx.approver1; reason = "Wrong total"
  fourth <- inputFor fx "2026-09" 1000.0
  assertMsg "attempt 3 after the rejection" (fourth.attempt == 3)
  _ <- propose fx fourth
  pure ()

-- | Sealing new terms hands the attempt numbers over, so a cycle's record ids stay unique
-- across Mandates.
test_attempt_numbers_survive_a_new_mandate : Script ()
test_attempt_numbers_survive_a_new_mandate = do
  fx0 <- setup
  input <- inputFor fx0 "2026-09" 1000.0
  (first, _) <- propose fx0 input
  _ <- submit fx0.treasurer $ exerciseCmd first Proposal_Cancel
  fx <- reseal fx0 (fx0.terms with cap = 8000.0)
  m <- liveMandate fx
  assertMsg "the new Mandate remembers attempt 1" (m.version == 2 && lastAttemptOf "2026-09" m.cycleAttempts == 1)
  proposeFailsWith "is not the next one" fx input
  next <- inputFor fx "2026-09" 1000.0
  assertMsg "so the next attempt is 2" (next.attempt == 2)
  _ <- propose fx next
  pure ()

-- L6 -------------------------------------------------------------------------

-- | Nobody but the treasury can turn a treasurer-signed request into a Mandate, and the
-- agent cannot create or change anything that carries the treasurer's signature.
test_l6_agent_cannot_change_mandate : Script ()
test_l6_agent_cannot_change_mandate = do
  fx <- setup
  let lower = fx.terms with cap = 1000000.0
      forgedMandate = Mandate with
        treasury = fx.treasury
        treasurer = fx.treasurer
        agent = fx.agent
        version = 2
        terms = lower
        agentExecutes = True
        executedCycles = []
        cycleAttempts = []
        sealedAt = today
        summaryFingerprint = "forged"
  -- the agent cannot create a Mandate
  failsWith notAuthorized (actAs fx.agent) (createCmd forgedMandate)
  -- nor the treasurer alone: the treasury's authority is needed too
  failsWith notAuthorized (actAs fx.treasurer) (createCmd forgedMandate)
  -- the agent cannot create a seal request in the treasurer's name
  let forgedRequest = MandateSealRequest with
        treasury = fx.treasury
        treasurer = fx.treasurer
        agent = fx.agent
        terms = lower
        agentExecutes = True
        summary = "raise the cap"
        summaryFingerprint = "forged"
        requestedAt = today
  failsWith notAuthorized (actAs fx.agent) (createCmd forgedRequest)
  -- a request signed by the agent itself is not accepted as the treasurer's
  agentRequest <- submit fx.agent $ createCmd (forgedRequest with treasurer = fx.agent)
  failsWith notAuthorized (actAs fx.agent)
    (exerciseCmd fx.orgCid Org_ApplySeal with sealRequestCid = agentRequest; currentMandateCid = Some fx.mandateCid)
  -- even with a genuine request, the agent cannot apply it, and neither can the treasurer
  genuine <- sealRequest fx lower True
  failsWith notAuthorized (actAs fx.agent)
    (exerciseCmd fx.orgCid Org_ApplySeal with sealRequestCid = genuine; currentMandateCid = Some fx.mandateCid)
  failsWith notAuthorized (actAs fx.treasurer)
    (exerciseCmd fx.orgCid Org_ApplySeal with sealRequestCid = genuine; currentMandateCid = Some fx.mandateCid)
  -- the agent cannot supersede the Mandate or touch the organization
  failsWith notAuthorized (actAs fx.agent) (exerciseCmd fx.mandateCid Mandate_Supersede)
  -- nothing changed
  m <- liveMandate fx
  assertMsg "the cap is unchanged" (m.terms.cap == 5000.0 && m.version == 1)
  -- invalid terms cannot even be requested
  let badThreshold = fx.terms with approvalThreshold = 3
      agentApprover = fx.terms with approvers = [fx.approver1, fx.agent]
      negativeCap = fx.terms with cap = -1.0
  forA_ [badThreshold, agentApprover, negativeCap] $ \t ->
    submitMustFail fx.treasurer $ createCmd MandateSealRequest with
      treasury = fx.treasury; treasurer = fx.treasurer; agent = fx.agent; terms = t
      agentExecutes = True; summary = "invalid"; summaryFingerprint = "00"; requestedAt = today

-- | A treasurer-signed request, applied by the treasury, replaces the Mandate and
-- carries the executed cycles over.
test_l6_treasurer_signed_reseal_succeeds : Script ()
test_l6_treasurer_signed_reseal_succeeds = do
  fx <- setup
  (fx1, _) <- distribute fx "2026-09" 1000.0
  let newTerms = fx.terms with
        cap = 8000.0
        approvers = [fx.approver1]
        approvalThreshold = 1
  req <- sealRequest fx1 newTerms True
  -- the current Mandate must be named once one exists
  failsWith "current Mandate must be given"
    (actAs fx.treasury) (exerciseCmd fx1.orgCid Org_ApplySeal with sealRequestCid = req; currentMandateCid = None)
  (org2, mandate2) <- submit fx.treasury $ exerciseCmd fx1.orgCid Org_ApplySeal with
    sealRequestCid = req
    currentMandateCid = Some fx1.mandateCid
  m <- mandateOf fx1 mandate2
  assertMsg "version is incremented" (m.version == 2)
  assertMsg "executed cycles carry over" (m.executedCycles == ["2026-09"])
  assertMsg "new terms are in force" (m.terms.cap == 8000.0 && m.terms.approvers == [fx.approver1])
  Some org <- queryContractId fx.treasury org2
  assertMsg "the organization follows" (org.mandateVersion == 2 && org.approvers == [fx.approver1] && org.approvalThreshold == 1)
  mandates <- query @Mandate fx.treasury
  assertMsg "exactly one active Mandate" (length mandates == 1)
  -- the old request is consumed and the old Mandate is gone
  submitMustFail fx.treasury
    (exerciseCmd org2 Org_ApplySeal with sealRequestCid = req; currentMandateCid = Some mandate2)
  -- the executed cycle still cannot be distributed again
  input <- inputFor (fx1 with mandateCid = mandate2) "2026-09" 1000.0
  proposeFailsWith "has already been executed" (fx1 with mandateCid = mandate2) input

-- A5 -------------------------------------------------------------------------

-- | A failed blocking check forces approval even when the total is under the cap.
test_a5_blocking_flag_forces_approval_under_cap : Script ()
test_a5_blocking_flag_forces_approval_under_cap = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  let spike = CheckResult with
        code = "unit_spike"
        label = "Unit change in the last 30 days"
        passed = False
        blocking = True
        actual = "C: +400% in 30 days"
        limit = "25%"
        source = "deterministic"
  (proposalCid, recordCid) <- propose fx (input with checks = input.checks ++ [spike])
  p <- proposalOf fx proposalCid
  assertMsg "under the cap but flagged: needs approval" (p.verdict == NeedsApproval)
  d <- decisionOf fx recordCid
  assertMsg "the failed check is kept as given" (spike `elem` d.checks)
  cmd <- executeCmd fx proposalCid
  failsWith "needs 2 approval(s)" (asAgent fx) cmd
  approved <- approveBoth fx proposalCid
  (_, outcomeCid) <- execute fx approved
  o <- outcomeOf fx outcomeCid
  assertMsg "executed after the approvals" (o.kind == Executed && length o.approvals == 2)

-- | An advisory flag (not blocking) does not stop auto-execution.
test_a5_advisory_flag_does_not_block : Script ()
test_a5_advisory_flag_does_not_block = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  let aiFlag = CheckResult with
        code = "ai_advisory"
        label = "The memo mentions a one-off item"
        passed = False
        blocking = False
        actual = "possible one-off"
        limit = "-"
        source = "ai"
      softDeviation = CheckResult with
        code = "deviation"
        label = "Deviation from trailing average"
        passed = False
        blocking = False
        actual = "+60%"
        limit = "50%"
        source = "deterministic"
  (proposalCid, _) <- propose fx (input with checks = input.checks ++ [aiFlag, softDeviation])
  p <- proposalOf fx proposalCid
  assertMsg "advisory failures keep auto-execute" (p.verdict == AutoExecute)
  (_, outcomeCid) <- execute fx proposalCid
  o <- outcomeOf fx outcomeCid
  assertMsg "executed" (o.kind == Executed)

-- | The AI can add flags but cannot make one that blocks, and checks must name their source.
test_a5_ai_check_cannot_be_blocking : Script ()
test_a5_ai_check_cannot_be_blocking = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  let aiBlocking = CheckResult with
        code = "ai_advisory"; label = "x"; passed = False; blocking = True
        actual = "x"; limit = "x"; source = "ai"
      unknownSource = CheckResult with
        code = "cap"; label = "x"; passed = True; blocking = False
        actual = "x"; limit = "x"; source = "operator"
  proposeFailsWith "AI checks are advisory" fx (input with checks = [aiBlocking])
  proposeFailsWith "deterministic rules or from the AI" fx (input with checks = [unknownSource])

-- | The agent supplies checks, never the verdict: a passing "cap" check does not lift
-- the cap.
test_a6_exceeding_cap_never_executes_without_approval : Script ()
test_a6_exceeding_cap_never_executes_without_approval = do
  fx <- setup
  input <- inputFor fx "2026-09" 9000.0
  -- the agent claims the cap check passed
  (proposalCid, _) <- propose fx (input with checks = [passingCheck "cap" "Within cap"])
  p <- proposalOf fx proposalCid
  assertMsg "9,000 is above the 5,000 cap" (p.verdict == NeedsApproval)
  cmd <- executeCmd fx proposalCid
  failsWith "needs 2 approval(s)" (asAgent fx) cmd
  approved <- approveBoth fx proposalCid
  (_, outcomeCid) <- execute fx approved
  o <- outcomeOf fx outcomeCid
  assertMsg "executes once approved" (o.kind == Executed)

-- | Other propose rules: positive total, attempt numbering, and a register of the right treasury.
test_propose_input_rules : Script ()
test_propose_input_rules = do
  fx <- setup
  input <- inputFor fx "2026-09" 1000.0
  proposeFailsWith "Total must be greater than zero" fx (input with total = 0.0)
  proposeFailsWith "Attempt numbers start at 1" fx (input with attempt = 0)
  -- a register created for another treasury is not accepted
  other <- allocatePartyByHint (PartyIdHint "otherTreasury")
  otherRegister <- submit other $ createCmd UnitRegister with
    treasury = other; treasurer = fx.treasurer; agent = fx.agent; changes = []
  proposeFailsWith "different treasury" fx (input with registerCid = otherRegister)
  -- the holder-less case: no units on the record date (January 2025 is before any units)
  proposeFailsWith "No fund unit holders" fx (input with cycleId = "2025-01"; recordDate = date 2025 Jan 31)
